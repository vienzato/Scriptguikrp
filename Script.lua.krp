local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not success or not Rayfield then
    warn("Không thể tải Rayfield UI.")
    return
end

local Window = Rayfield:CreateWindow({
    Name = "Custom Hub - Viễn",
    LoadingTitle = "Đang khởi tạo giao diện...",
    LoadingSubtitle = "By Viễn",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local Tab = Window:CreateTab("Chính", 4483362458)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local guiParent = pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

-- ==================== NÚT 1: TOOL TELEPORT ====================
local tpToolActive = false
local tpToolConnection = nil

local function giveTpTool()
    if not tpToolActive then return end
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    
    for _, v in pairs(backpack:GetChildren()) do
        if v.Name == "TeleportTool" then v:Destroy() end
    end
    if char:FindFirstChild("TeleportTool") then char.TeleportTool:Destroy() end

    local tool = Instance.new("Tool")
    tool.Name = "TeleportTool"
    tool.RequiresHandle = false
    tool.ToolTip = "Click chuột bất kỳ để dịch chuyển"
    
    tool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if mouse.Target then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
            end
        end
    end)
    tool.Parent = backpack
end

Tab:CreateToggle({
    Name = "1. Tool Teleport (Cấp lại sau 3s khi die/reset)",
    CurrentValue = false,
    Flag = "ToggleTPTool",
    Callback = function(Value)
        tpToolActive = Value
        if Value then
            giveTpTool()
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local humanoid = char:WaitForChild("Humanoid")
            if tpToolConnection then tpToolConnection:Disconnect() end
            tpToolConnection = humanoid.Died:Connect(function()
                if tpToolActive then
                    task.wait(3)
                    giveTpTool()
                end
            end)
        else
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, v in pairs(backpack:GetChildren()) do
                    if v.Name == "TeleportTool" then v:Destroy() end
                end
            end
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("TeleportTool") then char.TeleportTool:Destroy() end
            if tpToolConnection then tpToolConnection:Disconnect() end
        end
    end,
})

-- ==================== NÚT 2: ESP TÊN & KHOẢNG CÁCH ====================
local espActive = false
local espFolder = Instance.new("Folder")
espFolder.Name = "ESPFolder"
espFolder.Parent = guiParent

RunService.RenderStepped:Connect(function()
    if not espActive then
        for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pChar = player.Character
            local pHrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
            local head = pChar and pChar:FindFirstChild("Head")
            
            if pHrp and head then
                local dist = math.floor((hrp.Position - pHrp.Position).Magnitude)
                local billboardName = "ESP_" .. player.Name
                local billboard = espFolder:FindFirstChild(billboardName)
                
                if not billboard then
                    billboard = Instance.new("BillboardGui")
                    billboard.Name = billboardName
                    billboard.Size = UDim2.new(0, 200, 0, 50)
                    billboard.AlwaysOnTop = true
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    
                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "Text"
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    textLabel.TextStrokeTransparency = 0.5
                    textLabel.TextSize = 14
                    textLabel.Font = Enum.Font.SourceSansBold
                    textLabel.Parent = billboard
                    
                    billboard.Adornee = head
                    billboard.Parent = espFolder
                end
                
                local textLabel = billboard:FindFirstChild("Text")
                if textLabel then
                    textLabel.Text = player.Name .. "\n[" .. dist .. " studs]"
                end
            else
                local billboard = espFolder:FindFirstChild("ESP_" .. player.Name)
                if billboard then billboard:Destroy() end
            end
        end
    end
end)

Tab:CreateToggle({
    Name = "2. Hiển thị ESP Tên & Khoảng cách người chơi",
    CurrentValue = false,
    Flag = "ToggleESP",
    Callback = function(Value)
        espActive = Value
        if not Value then
            for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end
        end
    end,
})

-- ==================== NÚT 3: TỐC ĐỘ + THANH KÉO (MAX 350) ====================
local speedActive = false
local speedVal = 16
local speedConnection = nil

Tab:CreateToggle({
    Name = "3. Bật Tốc Độ Nhanh",
    CurrentValue = false,
    Flag = "ToggleSpeed",
    Callback = function(Value)
        speedActive = Value
        if Value then
            if speedConnection then speedConnection:Disconnect() end
            speedConnection = RunService.RenderStepped:Connect(function()
                local char = LocalPlayer.Character
                local humanoid = char and char:FindFirstChild("Humanoid")
                if humanoid then humanoid.WalkSpeed = speedVal end
            end)
        else
            if speedConnection then speedConnection:Disconnect() end
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            if humanoid then humanoid.WalkSpeed = 16 end
        end
    end,
})

Tab:CreateSlider({
    Name = "Tốc độ chạy (Tối đa 350)",
    Range = {16, 350},
    Increment = 1,
    Suffix = "Speed",
    CurrentValue = 16,
    Flag = "SliderSpeed",
    Callback = function(Value)
        speedVal = Value
        if speedActive then
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            if humanoid then humanoid.WalkSpeed = speedVal end
        end
    end,
})

-- ==================== NÚT 4: TOOL LƯU & TP VĨNH VIỄN ====================
local saveTpActive = false
local savedCFrame = nil
local currentSaveTool = nil
local charConnection4 = nil

local function giveSaveTpTool()
    if not saveTpActive then return end
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    local existingTool = backpack:FindFirstChild("SaveTpTool") or backpack:FindFirstChild("TP") or (char and (char:FindFirstChild("SaveTpTool") or char:FindFirstChild("TP")))
    if existingTool then
        currentSaveTool = existingTool
        return
    end

    local tool = Instance.new("Tool")
    tool.RequiresHandle = false

    if savedCFrame then
        tool.Name = "TP"
        tool.ToolTip = "Click để dịch chuyển về vị trí đã lưu"
    else
        tool.Name = "SaveTpTool"
        tool.ToolTip = "Click lần 1: Lưu tọa độ vĩnh viễn | Click lần 2+: Dịch chuyển"
    end

    tool.Activated:Connect(function()
        local currentCharacter = LocalPlayer.Character
        local hrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if not savedCFrame then
            savedCFrame = hrp.CFrame
            tool.Name = "TP"
            tool.ToolTip = "Click để dịch chuyển về vị trí đã lưu"
        else
            hrp.CFrame = savedCFrame
        end
    end)

    currentSaveTool = tool
    tool.Parent = backpack
end

Tab:CreateToggle({
    Name = "4. Tool Lưu & TP Tọa Độ (Check túi đồ khi hồi sinh)",
    CurrentValue = false,
    Flag = "ToggleSaveTpTool",
    Callback = function(Value)
        saveTpActive = Value
        if Value then
            giveSaveTpTool()
            if charConnection4 then charConnection4:Disconnect() end
            
            charConnection4 = LocalPlayer.CharacterAdded:Connect(function(newChar)
                if not saveTpActive then return end
                task.wait(1)
                giveSaveTpTool()
            end)
        else
            if charConnection4 then charConnection4:Disconnect() end
            savedCFrame = nil
            if currentSaveTool and currentSaveTool.Parent then
                currentSaveTool:Destroy()
            end
            currentSaveTool = nil
        end
    end,
})

-- ==================== NÚT 5: TOOL CHỐNG KẸT (CK) ====================
local antiStuckToolActive = false
local antiStuckHeight = 80
local currentAntiStuckTool = nil
local charConnection5 = nil

local function giveAntiStuckTool()
    if not antiStuckToolActive then return end
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    local existingTool = backpack:FindFirstChild("CK") or (char and char:FindFirstChild("CK"))
    if existingTool then
        currentAntiStuckTool = existingTool
        return
    end

    local tool = Instance.new("Tool")
    tool.Name = "CK"
    tool.RequiresHandle = false
    tool.ToolTip = "Click để đẩy lên cao chống kẹt"

    tool.Activated:Connect(function()
        local currentCharacter = LocalPlayer.Character
        local hrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame + Vector3.new(0, antiStuckHeight, 0)
        end
    end)

    currentAntiStuckTool = tool
    tool.Parent = backpack
end

Tab:CreateToggle({
    Name = "5. Tool Chống Kẹt [CK] (Check túi đồ khi hồi sinh)",
    CurrentValue = false,
    Flag = "ToggleAntiStuckTool",
    Callback = function(Value)
        antiStuckToolActive = Value
        if Value then
            giveAntiStuckTool()
            if charConnection5 then charConnection5:Disconnect() end
            
            charConnection5 = LocalPlayer.CharacterAdded:Connect(function(newChar)
                if not antiStuckToolActive then return end
                task.wait(1)
                giveAntiStuckTool()
            end)
        else
            if charConnection5 then charConnection5:Disconnect() end
            if currentAntiStuckTool and currentAntiStuckTool.Parent then
                currentAntiStuckTool:Destroy()
            end
            currentAntiStuckTool = nil
            
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, v in pairs(backpack:GetChildren()) do
                    if v.Name == "CK" then v:Destroy() end
                end
            end
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("CK") then
                char.CK:Destroy()
            end
        end
    end,
})

Tab:CreateSlider({
    Name = "Độ cao đẩy chống kẹt (Tối đa 180)",
    Range = {10, 180},
    Increment = 1,
    Suffix = "Studs",
    CurrentValue = 80,
    Flag = "SliderAntiStuck",
    Callback = function(Value)
        antiStuckHeight = Value
    end,
})
